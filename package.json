{
  "name": "@flippydisk/tools",
  "version": "2.0.0",
  "description": "Framework-independent JavaScript utilities for browsers and Node.js",
  "homepage": "https://www.flippydisk.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flippydisk/tools.git"
  },
  "author": "Jim O'Harra-Sutton (https://www.flippydisk.com)",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./debug": {
      "import": "./dist/esm/debug/debug.js",
      "require": "./dist/cjs/debug/debug.cjs"
    },
    "./disable": {
      "import": "./dist/esm/disable/disable.js",
      "require": "./dist/cjs/disable/disable.cjs"
    },
    "./json": {
      "import": "./dist/esm/json/json.js",
      "require": "./dist/cjs/json/json.cjs"
    },
    "./json/ajax": {
      "import": "./dist/esm/json/ajax.js",
      "require": "./dist/cjs/json/ajax.cjs"
    },
    "./lang": {
      "import": "./dist/esm/lang/lang.js",
      "require": "./dist/cjs/lang/lang.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "flippydisk",
    "tools",
    "javascript",
    "utilities",
    "debug",
    "logging",
    "fetch"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "scripts": {
    "lint": "eslint src test/*.test.js scripts",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run test:unit && npm run build && npm run test:package",
    "test:unit": "node --test --experimental-test-coverage test/ajax.test.js test/debug.test.js test/disable.test.js test/lang.test.js",
    "test:watch": "node --test --watch",
    "build": "node ./scripts/build.js",
    "bump": "node ./scripts/bump.js",
    "check": "npm run lint && npm test && npm pack --dry-run",
    "release": "node ./scripts/release.js",
    "test:package": "node --test test/package.test.js"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/flippydisk/tools/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
